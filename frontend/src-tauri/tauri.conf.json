{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://127.0.0.1:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "AIComicTool",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "AIComicTool",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      }
    },
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "identifier": "com.ljc.aicomictool",
      "targets": ["app"],
      "icon": [
        "../../data/111/characters/漫剧-张小凡-正视图.png"
      ],
      "resources": [
        "../../backend/**",
        "../../requirements.txt"
      ],
      "macOS": {
        "entitlements": null
      }
    }
  }
}


