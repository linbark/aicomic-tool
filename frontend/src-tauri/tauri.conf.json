{
  "build": {
    "beforeDevCommand": "sh -c \"npm --prefix ../react-frontend run dev -- --host 0.0.0.0 --port 5173 --strictPort || npm --prefix ../../react-frontend run dev -- --host 0.0.0.0 --port 5173 --strictPort\"",
    "beforeBuildCommand": "sh -c \"npm --prefix ../react-frontend run build || npm --prefix ../../react-frontend run build\"",
    "devPath": "http://127.0.0.1:5173",
    "distDir": "../../react-frontend/dist"
  },
  "package": {
    "productName": "星晴",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "星晴",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      }
    },
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "identifier": "com.ljc.aicomictool",
      "targets": ["app"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.icns"
      ],
      "resources": [
        "../../backend/**",
        "../../requirements.txt"
      ],
      "macOS": {
        "entitlements": null
      }
    }
  }
}


